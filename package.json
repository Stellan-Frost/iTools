{
  "name": "itools",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/run-turbo.mjs build",
    "build:workspace-deps": "pnpm --filter @itools/contracts build && pnpm --filter @itools/app-core build && pnpm --filter @itools/design-system-adapter build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tools": "node scripts/check-tool-registry.mjs",
    "dev": "pnpm run build:workspace-deps && pnpm --filter @itools/server dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages scripts && pnpm check:boundaries && pnpm check:imports && pnpm check:tokens && pnpm check:privacy",
    "test": "node --env-file-if-exists=.env scripts/run-turbo.mjs test --concurrency=1",
    "typecheck": "node scripts/run-turbo.mjs typecheck",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:privacy": "node scripts/check-no-network.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-external-resources.mjs && pnpm check:tools && pnpm check:i18n && node scripts/verify-stage-4.mjs && node scripts/verify-stage-10.mjs",
    "test:db": "node --env-file-if-exists=.env scripts/run-turbo.mjs test --filter=@itools/db",
    "check:external": "node scripts/check-external-resources.mjs",
    "check:audit": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
