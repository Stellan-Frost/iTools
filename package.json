{
  "name": "itools",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/run-turbo.mjs build",
    "build:workspace-deps": "pnpm --filter @itools/contracts build && pnpm --filter @itools/app-core build && pnpm --filter @itools/design-system-adapter build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tools": "node scripts/check-tool-registry.mjs",
    "dev": "pnpm run build:workspace-deps && pnpm --filter @itools/server dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages scripts && pnpm check:boundaries",
    "test": "node scripts/run-turbo.mjs test",
    "typecheck": "node scripts/run-turbo.mjs typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
