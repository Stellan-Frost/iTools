{
  "name": "itools",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/run-turbo.mjs build",
    "build:workspace-deps": "pnpm --filter @itools/contracts build && pnpm --filter @itools/app-core build && pnpm --filter @itools/design-system-adapter build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tools": "node scripts/check-tool-registry.mjs",
    "dev": "pnpm run build:workspace-deps && pnpm --filter @itools/server dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages scripts e2e playwright.config.ts && pnpm check:boundaries && pnpm check:imports && pnpm check:tokens && pnpm check:privacy",
    "test": "node --env-file-if-exists=.env scripts/run-turbo.mjs test --concurrency=1",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "report:coverage": "node --env-file-if-exists=.env scripts/run-turbo.mjs test --concurrency=1 -- --coverage",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:duplication": "jscpd apps packages --format typescript,tsx,javascript --ignore **/dist/**,**/*.test.*,**/test-support/** --min-lines 10 --min-tokens 80 --threshold 0 --reporters console,threshold",
    "check:openapi": "node --env-file-if-exists=.env scripts/check-openapi-diff.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "check:performance": "node scripts/measure-performance.mjs --check-budget",
    "typecheck": "node scripts/run-turbo.mjs typecheck",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:privacy": "node scripts/check-no-network.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-external-resources.mjs && pnpm check:tools && pnpm check:i18n && node scripts/verify-stage-4.mjs && node scripts/verify-stage-10.mjs",
    "verify:stage11": "pnpm verify && pnpm typecheck:e2e && pnpm report:coverage && pnpm check:coverage && node --test scripts/check-openapi-diff.test.mjs scripts/performance-budget.test.mjs && pnpm check:openapi && pnpm check:duplication && pnpm test:e2e && pnpm check:performance && pnpm check:audit",
    "test:db": "node --env-file-if-exists=.env scripts/run-turbo.mjs test --filter=@itools/db",
    "check:external": "node scripts/check-external-resources.mjs",
    "check:audit": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
