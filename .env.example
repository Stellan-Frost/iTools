# 阶段 7 的服务端配置；本地开发库用便携版 PostgreSQL（见 docs/11）。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://itools:change-me@127.0.0.1:5432/itools
# 仅测试使用；必须指向独立的空库，测试会重建其中的表。
TEST_DATABASE_URL=postgresql://itools:change-me@127.0.0.1:5432/itools_test

# 管理后台初始化令牌（至少 24 字符）；未设置时初始化入口不存在。
# 生成：node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ADMIN_SETUP_TOKEN=
