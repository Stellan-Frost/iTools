{
  "name": "@itools/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch-path=./src --import tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --no-file-parallelism --testTimeout=30000",
    "admin:reset-password": "node dist/cli/reset-password.js"
  },
  "dependencies": {
    "@fastify/middie": "9.3.5",
    "@fastify/static": "10.1.6",
    "@itools/contracts": "workspace:*",
    "fastify": "5.12.7",
    "@fastify/swagger": "9.9.2",
    "@itools/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "vite": "8.3.4"
  }
}
